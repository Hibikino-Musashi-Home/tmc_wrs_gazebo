<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="wrc_ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>10 10</size>
          </plane>
        </geometry>
        <surface>
          <contact>
             <collide_bitmask>0xffff</collide_bitmask>
          </contact>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>10 10</size>
          </plane>
        </geometry>
        <material>
          <name>wrc_ground_plane</name>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://wrc_ground_plane/materials/textures/wood.png</albedo_map>
              <metalness>0.0</metalness>
              <scale>0.2 0.2</scale>
              <shading>gouraud</shading>
              <receive_shadows>on</receive_shadows>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
